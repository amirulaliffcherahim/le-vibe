{
  "trusted_folders": ["."],
  "tool_permissions": {
    "read": "always",
    "grep": "always",
    "find": "always",
    "ls": "always",
    "todo": "always",
    "ask_user_question": "always",
    "write": "ask",
    "edit": "ask",
    "bash": "ask",
    "powershell": "ask"
  },
  "allowed_commands": [
    "git status",
    "git diff *",
    "git log *",
    "cargo test *",
    "cargo check *",
    "pytest *"
  ],
  "allowed_paths": [],
  "allow_patterns": [
    "bash(cargo test*)",
    "bash(cargo clippy*)",
    "powershell(cargo test*)"
  ],
  "deny_patterns": [
    "write(.env*)",
    "edit(.env*)",
    "bash(*--force*)"
  ],
  "require_read_before_edit": true,
  "guard_dirty_repo": true,
  "blocked_commands": [
    "git push --force",
    "git reset --hard"
  ]
}
