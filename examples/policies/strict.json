{
  "trusted_folders": ["."],
  "tool_permissions": {
    "read": "always",
    "grep": "always",
    "find": "always",
    "ls": "always",
    "todo": "ask",
    "ask_user_question": "always",
    "write": "ask",
    "edit": "ask",
    "bash": "never",
    "powershell": "never"
  },
  "allowed_commands": [],
  "allowed_paths": [],
  "deny_patterns": [
    "write(.env*)",
    "edit(.env*)",
    "edit(*.pem)"
  ],
  "require_read_before_edit": true,
  "guard_dirty_repo": true,
  "blocked_commands": [
    "rm -rf",
    "del /s"
  ]
}
